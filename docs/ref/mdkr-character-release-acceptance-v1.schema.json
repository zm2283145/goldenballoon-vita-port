{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenballoon.dev/schema/mdkr-character-release-acceptance-v1.schema.json",
  "title": "Golden Balloon Custom Character Workshop release acceptance receipt",
  "description": "Privacy-bounded human and physical-device evidence for exact packaged desktop candidates. Cross-record completeness and artifact-byte checks are enforced by tools/check_character_release_evidence.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "package",
    "artifacts",
    "runs",
    "device_profiles"
  ],
  "properties": {
    "schema": {
      "const": "mdkr-character-release-acceptance/1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(dev|[0-9]+(\\.[0-9]+){1,2})$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_sha256",
        "package_sha256",
        "license_sha256",
        "evidence_report_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$"
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "package_sha256": {"$ref": "#/$defs/sha256"},
        "license_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "runs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/run"}
    },
    "device_profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/deviceProfile"}
    },
    "notes": {"$ref": "#/$defs/note"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "statusNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_available"]},
        "note": {"type": "string", "maxLength": 500}
      }
    },
    "passStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "note": {"type": "string", "maxLength": 500}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "filename", "sha256", "provenance_sha256"],
      "properties": {
        "role": {
          "enum": ["macos", "windows", "linux_appimage", "linux_tarball"]
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "provenance_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "modalities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mouse", "keyboard", "controller", "touch", "screen_reader"],
      "properties": {
        "mouse": {"$ref": "#/$defs/statusNote"},
        "keyboard": {"$ref": "#/$defs/statusNote"},
        "controller": {"$ref": "#/$defs/statusNote"},
        "touch": {"$ref": "#/$defs/statusNote"},
        "screen_reader": {"$ref": "#/$defs/statusNote"}
      }
    },
    "layouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinary", "scale_200_percent", "narrow_640x480"],
      "properties": {
        "ordinary": {"$ref": "#/$defs/passStatus"},
        "scale_200_percent": {"$ref": "#/$defs/passStatus"},
        "narrow_640x480": {"$ref": "#/$defs/passStatus"}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reduced_motion", "colour_vision"],
      "properties": {
        "reduced_motion": {"$ref": "#/$defs/passStatus"},
        "colour_vision": {"$ref": "#/$defs/passStatus"}
      }
    },
    "journeys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rom_free_intake",
        "failure_recovery",
        "offset_studio",
        "rig_and_motion",
        "portrait_identity",
        "unicode_identity",
        "exact_test_matrix",
        "package_lifecycle",
        "authority_and_fallback"
      ],
      "properties": {
        "rom_free_intake": {"$ref": "#/$defs/passStatus"},
        "failure_recovery": {"$ref": "#/$defs/passStatus"},
        "offset_studio": {"$ref": "#/$defs/passStatus"},
        "rig_and_motion": {"$ref": "#/$defs/passStatus"},
        "portrait_identity": {"$ref": "#/$defs/passStatus"},
        "unicode_identity": {"$ref": "#/$defs/passStatus"},
        "exact_test_matrix": {"$ref": "#/$defs/passStatus"},
        "package_lifecycle": {"$ref": "#/$defs/passStatus"},
        "authority_and_fallback": {"$ref": "#/$defs/passStatus"}
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front", "side", "top", "underside"],
      "properties": {
        "front": {"$ref": "#/$defs/passStatus"},
        "side": {"$ref": "#/$defs/passStatus"},
        "top": {"$ref": "#/$defs/passStatus"},
        "underside": {"$ref": "#/$defs/passStatus"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note", "views"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "note": {"type": "string", "maxLength": 500},
        "views": {"$ref": "#/$defs/views"}
      }
    },
    "exactContexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select", "car", "hovercraft", "plane"],
      "properties": {
        "select": {"$ref": "#/$defs/context"},
        "car": {"$ref": "#/$defs/context"},
        "hovercraft": {"$ref": "#/$defs/context"},
        "plane": {"$ref": "#/$defs/context"}
      }
    },
    "playerLayouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1p", "2p", "3p", "4p"],
      "properties": {
        "1p": {"$ref": "#/$defs/passStatus"},
        "2p": {"$ref": "#/$defs/passStatus"},
        "3p": {"$ref": "#/$defs/passStatus"},
        "4p": {"$ref": "#/$defs/passStatus"}
      }
    },
    "identitySurfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character_select",
        "hud",
        "results_rankings",
        "minimap",
        "collection_flag",
        "custom_roster"
      ],
      "properties": {
        "character_select": {"$ref": "#/$defs/passStatus"},
        "hud": {"$ref": "#/$defs/passStatus"},
        "results_rankings": {"$ref": "#/$defs/passStatus"},
        "minimap": {"$ref": "#/$defs/passStatus"},
        "collection_flag": {"$ref": "#/$defs/passStatus"},
        "custom_roster": {"$ref": "#/$defs/passStatus"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "artifact_sha256s",
        "observed_at",
        "os",
        "gpu",
        "driver",
        "display",
        "modalities",
        "layouts",
        "accessibility",
        "journeys",
        "exact_contexts",
        "player_layouts",
        "identity_surfaces"
      ],
      "properties": {
        "platform": {"enum": ["macos", "windows", "linux"]},
        "artifact_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "os": {"type": "string", "minLength": 1, "maxLength": 300},
        "gpu": {"type": "string", "minLength": 1, "maxLength": 300},
        "driver": {"type": "string", "minLength": 1, "maxLength": 300},
        "display": {"type": "string", "minLength": 1, "maxLength": 300},
        "modalities": {"$ref": "#/$defs/modalities"},
        "layouts": {"$ref": "#/$defs/layouts"},
        "accessibility": {"$ref": "#/$defs/accessibility"},
        "journeys": {"$ref": "#/$defs/journeys"},
        "exact_contexts": {"$ref": "#/$defs/exactContexts"},
        "player_layouts": {"$ref": "#/$defs/playerLayouts"},
        "identity_surfaces": {"$ref": "#/$defs/identitySurfaces"},
        "notes": {"$ref": "#/$defs/note"}
      }
    },
    "deviceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "platform", "profile_sha256", "result", "note"],
      "properties": {
        "tier": {"enum": ["low", "mid", "high"]},
        "platform": {"enum": ["macos", "windows", "linux"]},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"enum": ["pass", "exception"]},
        "note": {"type": "string", "maxLength": 500}
      }
    }
  }
}
